# Playwright E2E environment (M8 Phase 1A, ADR-0042) — FTA §14.
# Copy this file to .env.e2e (gitignored) — do not commit .env.e2e itself.
#
# VITE_API_BASE_URL is read BOTH by the Vite app (via `vite --mode e2e`, the
# in-app fail-closed check in src/infrastructure/config/env.ts) and by the
# Playwright test runner itself (e2e/env.ts, e2e/global-setup.ts). It MUST be
# exactly the isolated E2E backend's URL — both guards refuse to run under
# any other value. See docs/e2e-testing.md (backend repo) for how to stand up
# the isolated backend this points at.
VITE_API_BASE_URL=http://127.0.0.1:8010/api/v1

# Deterministic E2E credentials — the existing AdminUserSeeder's seeded test
# admin (backend, unchanged). This is a seed-only test account, never a real
# developer/admin password.
E2E_ADMIN_EMAIL=active@example.com
E2E_ADMIN_PASSWORD=password123
